# Values remain server-side. Register only the matching variable name in
# Context -> Provider credentials; Napier never persists or returns the value.
# The deterministic demo model works without any credentials.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

NAPIER_PORT=8787
# NAPIER_HOME=/absolute/path/to/runtime-data
# NAPIER_RELEASE_SIGNING_KEY=<Ed25519 PKCS#8 PEM or base64:DER>
# NAPIER_EXTENSION_SIGNING_KEY=<Ed25519 PKCS#8 PEM or base64:DER>
# NAPIER_WORKSPACE=/absolute/path/to/agent-workspace
