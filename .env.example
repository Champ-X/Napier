# Copy to the ignored root .env without overwriting existing local values.
# npm run dev reloads services after .env changes. Then use Check again in
# provider setup and enable the detected provider. Other launch modes need a restart.
# Manual references: Settings -> Agent & Model -> Evidence -> Provider credentials.
# Register only the variable name; values remain server-side.
# The deterministic demo model works without any credentials.
# DeepSeek V4 Flash is preferred when DeepSeek is configured and active.
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Optional search providers; keyless Bing RSS and DuckDuckGo are fallback routes.
# FIRECRAWL_API_KEY=
# BRAVE_API_KEY=
# TAVILY_API_KEY=

# API port; Vite starts at 5173 and tries the next free port.
NAPIER_PORT=8787
# Set these absolute paths for this machine. Startup uses NAPIER_WORKSPACE again
# after a restart; a folder-picker change only updates the active Server workspace.
# NAPIER_WORKSPACE=/absolute/path/to/agent-workspace
# NAPIER_HOME=/absolute/path/to/runtime-data
# Optional Docker endpoint when this host uses a non-default socket.
# DOCKER_HOST=unix:///absolute/path/to/docker.sock

# Optional recovery for hosts without a working OS/container Sandbox.
# This runs commands with the current user's full host authority and no OS isolation.
# NAPIER_HOST_DIRECT_SANDBOX=1

# Release/extension signing only; not required for local development.
# NAPIER_RELEASE_SIGNING_KEY=<Ed25519 PKCS#8 PEM or base64:DER>
# NAPIER_EXTENSION_SIGNING_KEY=<Ed25519 PKCS#8 PEM or base64:DER>
