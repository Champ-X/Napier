{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "benchmark-results/**",
    "benchmarks/**/expected/**",
    "benchmarks/**/fixture/**",
    "benchmarks/**/tests/**",
    "examples/**",
    "packages/runtime/test/fixtures/**",
    "benchmarks/harness-optimization/*/outcome.mjs",
    "benchmarks/harness-optimization/**/reference/**",
    "benchmarks/harness-optimization/*/reference.mjs",
    "benchmarks/harness-failures/*/outcome.mjs"
  ],
  "ignoreDependencies": ["preact"],
  "ignoreBinaries": ["docker.exe"],
  "workspaces": {
    ".": {
      "entry": [
        "benchmarks/harness-components/*/outcome.mjs",
        "benchmarks/harness-supplemental/*.mjs",
        "integrations/tessmora/scripts/mma-rag.mjs",
        "scripts/benchmark-subagent-workspace.mjs",
        "scripts/capture-sdk-capability-parity.mjs",
        "scripts/check-composer-drafts-ui.mjs",
        "scripts/check-control-outbox-ui.mjs",
        "scripts/check-execution-resource-coordination.mjs",
        "scripts/check-harness-corpus-catalog.mjs",
        "scripts/check-operator-decision-recovery.mjs",
        "scripts/check-operator-decision-ui.mjs",
        "scripts/check-recovery-operations-ui.mjs",
        "scripts/check-run-control-idempotency.mjs",
        "scripts/check-sandbox-execution-lifetime.mjs",
        "scripts/check-task-outcome-ui.mjs",
        "scripts/check-unsettled-patch-recovery.mjs",
        "scripts/check-verified-patch-recovery.mjs",
        "scripts/check-workflow-approval-recovery.mjs",
        "scripts/check-workflow-recovery-ui.mjs",
        "scripts/check-workspace-approval-review-ui.mjs",
        "scripts/check-workspace-html-preview.mjs",
        "scripts/check-workspace-overlay-ui.mjs",
        "scripts/check-workspace-resource-coordination.mjs",
        "scripts/check-workspace-resource-reclaim.mjs",
        "scripts/check-workspace-runtime-recovery.mjs",
        "scripts/check-workspace-runtime-ui.mjs",
        "scripts/compare-harness-preparation.mjs",
        "scripts/execution-resource-host-fixture.mjs",
        "scripts/harness-preparation-comparison-worker.mjs",
        "scripts/linux-host-product-acceptance-guest.mjs",
        "scripts/profile-harness-preparation.mjs",
        "scripts/refresh-skill-load-fast-core-evidence.mjs",
        "scripts/run-credential-reference-canary.ts",
        "scripts/run-skill-lifecycle-ab-dogfood.mjs",
        "scripts/run-skill-load-fast-core-evidence.mjs",
        "scripts/run-skill-load-final-check.mjs",
        "scripts/run-skill-resource-dogfood.mjs",
        "scripts/run-standard-skill-directory-dogfood.mjs",
        "scripts/verify-task-studio.mjs",
        "scripts/windows-host-product-acceptance-live.mjs"
      ],
      "project": ["**/*.{js,mjs,cjs,jsx,ts,tsx,mts,cts}!"]
    },
    "apps/cli": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/benchmark-kit": {
      "entry": [
        "src/*benchmark*.ts!",
        "src/open-web-research-*.ts!",
        "test/**/*.test.ts"
      ],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "apps/server": {
      "entry": ["src/index.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "apps/web": {
      "entry": [
        "src/main.tsx!",
        "src/kernel-browser-inspector-slot.ts!",
        "src/*.zh.ts!",
        "test/**/*.test.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}!", "test/**/*.{ts,tsx}"]
    },
    "packages/contracts": {
      "entry": ["src/index.ts!", "src/*.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/harness-eval": {
      "entry": ["src/harness-experiments.ts!", "test/**/*.test.ts"],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/runtime": {
      "entry": [
        "src/index.ts!",
        "src/browser-runtime-installer-child.ts!",
        "test/**/*.test.ts"
      ],
      "project": ["src/**/*.ts!", "test/**/*.ts"]
    },
    "packages/sdk": {
      "entry": [
        "src/index.ts!",
        "src/management.ts!",
        "examples/*.mjs",
        "test/**/*.test.ts"
      ],
      "project": ["src/**/*.ts!", "examples/*.mjs", "test/**/*.ts"]
    }
  }
}
