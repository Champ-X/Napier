{
  "name": "@napier/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "napier": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run --maxWorkers=4 --testTimeout=30000",
    "test:live-coding-benchmark": "NAPIER_LIVE_CODING_BENCHMARK=1 vitest run test/live-coding-benchmark-smoke.test.ts --testTimeout=180000",
    "test:live-deepseek": "NAPIER_LIVE_CLI_DEEPSEEK_SMOKE=1 vitest run test/live-deepseek-smoke.test.ts --testTimeout=60000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@napier/contracts": "*",
    "@napier/runtime": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.0",
    "@types/node": "24.12.4",
    "node-pty": "1.1.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
