{
  "name": "@napier/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "napier": "dist/index.js"
  },
  "exports": {
    "./runner": {
      "types": "./dist/benchmark-runner.d.ts",
      "import": "./dist/benchmark-runner.js"
    }
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "test": "npm run build && vitest run --maxWorkers=2 --testTimeout=30000",
    "test:live-deepseek": "npm run build && NAPIER_LIVE_CLI_DEEPSEEK_SMOKE=1 vitest run test/live-deepseek-smoke.test.ts --testTimeout=90000",
    "test:live-workflow-step": "npm run build && NAPIER_LIVE_WORKFLOW_STEP_SMOKE=1 vitest run test/live-workflow-step-control-smoke.test.ts --testTimeout=60000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@napier/contracts": "*",
    "@napier/runtime": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@types/node": "24.12.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
