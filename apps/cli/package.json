{
  "name": "@napier/cli",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "napier": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && vitest run --maxWorkers=4 --testTimeout=30000",
    "test:live-coding-benchmark": "NAPIER_LIVE_CODING_BENCHMARK=1 vitest run test/live-coding-benchmark-smoke.test.ts --testTimeout=180000",
    "test:live-data-benchmark": "NAPIER_LIVE_DATA_BENCHMARK=1 vitest run test/live-data-benchmark-smoke.test.ts --testTimeout=180000",
    "test:live-long-horizon-benchmark": "NAPIER_LIVE_LONG_HORIZON_BENCHMARK=1 vitest run test/live-long-horizon-benchmark-smoke.test.ts --testTimeout=180000",
    "test:live-research-benchmark": "NAPIER_LIVE_RESEARCH_BENCHMARK=1 vitest run test/live-research-benchmark-smoke.test.ts --testTimeout=180000",
    "test:live-security-benchmark": "NAPIER_LIVE_SECURITY_BENCHMARK=1 vitest run test/live-security-benchmark-smoke.test.ts --testTimeout=180000",
    "test:live-ux-benchmark": "NAPIER_LIVE_UX_BENCHMARK=1 vitest run test/live-ux-benchmark-smoke.test.ts --testTimeout=180000",
    "test:live-workflow-benchmark": "NAPIER_LIVE_WORKFLOW_BENCHMARK=1 vitest run test/live-workflow-benchmark-smoke.test.ts --testTimeout=180000",
    "test:live-deepseek": "npm run build && NAPIER_LIVE_CLI_DEEPSEEK_SMOKE=1 vitest run test/live-deepseek-smoke.test.ts --testTimeout=90000",
    "test:live-workflow-step": "npm run build && NAPIER_LIVE_WORKFLOW_STEP_SMOKE=1 vitest run test/live-workflow-step-control-smoke.test.ts --testTimeout=60000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@napier/contracts": "*",
    "@napier/runtime": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.0",
    "@types/node": "24.12.4",
    "node-pty": "1.1.0",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
