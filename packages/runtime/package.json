    "test:live-workflow-python": "NAPIER_LIVE_WORKFLOW_PYTHON_SMOKE=1 vitest run test/live-workflow-python-smoke.test.ts --testTimeout=30000",
    "test:live-deepseek": "NAPIER_LIVE_DEEPSEEK_SMOKE=1 vitest run test/live-deepseek-smoke.test.ts --testTimeout=60000",
