{
  "name": "@napier/runtime",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./web-search": {
      "types": "./dist/web-search.d.ts",
      "import": "./dist/web-search.js"
    },
    "./browser-interaction-confirmations": {
      "types": "./dist/browser-interaction-confirmations.d.ts",
      "import": "./dist/browser-interaction-confirmations.js"
    },
    "./browser-live-view": {
      "types": "./dist/browser-live-view.d.ts",
      "import": "./dist/browser-live-view.js"
    },
    "./browser-session-control": {
      "types": "./dist/browser-session-control.d.ts",
      "import": "./dist/browser-session-control.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --maxWorkers=4 --testTimeout=30000",
    "test:live-browser": "NAPIER_LIVE_BROWSER_SMOKE=1 vitest run test/live-browser-smoke.test.ts --testTimeout=60000",
    "test:live-coder": "NAPIER_LIVE_CODER_SUBAGENT_SMOKE=1 vitest run test/live-coder-subagent-smoke.test.ts --testTimeout=120000",
    "test:live-command": "NAPIER_LIVE_COMMAND_SMOKE=1 vitest run test/live-command-smoke.test.ts --testTimeout=30000",
    "test:live-files": "NAPIER_LIVE_WORKSPACE_FILE_SMOKE=1 vitest run test/live-workspace-file-smoke.test.ts --testTimeout=30000",
    "test:live-lsp": "NAPIER_LIVE_LSP_SMOKE=1 vitest run test/live-lsp-diagnostics-smoke.test.ts --testTimeout=30000",
    "test:live-linked-tests": "NAPIER_LIVE_LINKED_TEST_SMOKE=1 vitest run test/live-write-linked-test-smoke.test.ts --testTimeout=30000",
    "test:live-process": "NAPIER_LIVE_WORKSPACE_PROCESS_SMOKE=1 vitest run test/live-workspace-process-smoke.test.ts --testTimeout=30000",
    "test:live-provider": "NAPIER_LIVE_PROVIDER_CATALOG_SMOKE=1 vitest run test/live-provider-catalog-smoke.test.ts --testTimeout=60000",
    "test:live-sqlite": "NAPIER_LIVE_SQLITE_SMOKE=1 vitest run test/live-sqlite-query-smoke.test.ts --testTimeout=30000",
    "test:live-map": "NAPIER_LIVE_WORKFLOW_MAP_SMOKE=1 vitest run test/live-workflow-map-smoke.test.ts --testTimeout=120000",
    "test:live-loop": "NAPIER_LIVE_WORKFLOW_LOOP_SMOKE=1 vitest run test/live-workflow-loop-smoke.test.ts --testTimeout=120000",
    "test:live-workflow-javascript": "NAPIER_LIVE_WORKFLOW_JAVASCRIPT_SMOKE=1 vitest run test/live-workflow-javascript-smoke.test.ts --testTimeout=30000",
    "test:live-workflow-python": "NAPIER_LIVE_WORKFLOW_PYTHON_SMOKE=1 vitest run test/live-workflow-python-smoke.test.ts --testTimeout=30000",
    "test:live-deepseek": "NAPIER_LIVE_DEEPSEEK_SMOKE=1 vitest run test/live-deepseek-smoke.test.ts --testTimeout=60000",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.82.0",
    "@earendil-works/pi-ai": "0.82.0",
    "@mozilla/readability": "^0.6.0",
    "@napier/contracts": "*",
    "linkedom": "^0.18.13",
    "node-pty": "1.1.0",
    "pdfjs-dist": "^6.2.108",
    "playwright-core": "1.62.1",
    "typebox": "1.1.38",
    "typescript": "5.9.3",
    "typescript-language-server": "5.3.0",
    "vscode-jsonrpc": "8.2.1"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "vitest": "4.1.9"
  }
}
