{
  "name": "napier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "build": "npm run build:core && npm run build -w @napier/server && npm run build -w @napier/web",
    "build:core": "npm run build -w @napier/contracts && npm run build -w @napier/runtime",
    "check": "npm run check:runtime-environment && npm run check:runtime-environment-receipt && npm run check:package-lock && npm run check:package-lock-receipt && npm run check:management-openapi && npm run check:management-openapi-compatibility && npm run build && npm run check:web-dist-manifest && npm run check:web-dist && npm run check:web-dist-receipt && npm run check:release-artifacts && npm test",
    "check:management-openapi": "node scripts/generate-management-openapi.mjs --check",
    "check:management-openapi-compatibility": "node scripts/check-management-openapi-compatibility.mjs --verify-fixture-path docs/artifacts/management-openapi-compatibility-0.1.0.json",
    "check:package-lock": "node scripts/check-package-lock.mjs",
    "check:package-lock-receipt": "node scripts/check-package-lock.mjs --verify-receipt-path docs/artifacts/package-lock-audit-0.1.0.json",
    "check:release-artifacts": "node scripts/check-release-artifacts.mjs --verify-receipt-path docs/artifacts/release-artifacts-audit-0.1.0.json",
    "check:runtime-environment": "node scripts/check-runtime-environment.mjs",
    "check:runtime-environment-receipt": "node scripts/check-runtime-environment.mjs --verify-receipt-path docs/artifacts/runtime-environment-audit-0.1.0.json",
    "check:web-dist": "node scripts/check-web-dist.mjs",
    "check:web-dist-manifest": "node scripts/update-web-dist-manifest.mjs --check",
    "check:web-dist-receipt": "node scripts/check-web-dist.mjs --verify-receipt-path docs/artifacts/web-dist-audit-0.1.0.json",
    "dev": "npm run build:core && concurrently -n server,web -c yellow,cyan \"npm run dev -w @napier/server\" \"npm run dev -w @napier/web\"",
    "format": "prettier --write .",
    "test": "npm run test:root && npm run test --workspaces --if-present",
    "test:live-deepseek": "npm run test:live-deepseek -w @napier/runtime",
    "test:root": "vitest run scripts/*.test.mjs --testTimeout=30000",
    "typecheck": "npm run build:core && npm run typecheck -w @napier/server && npm run typecheck -w @napier/web",
    "update:web-dist-manifest": "node scripts/update-web-dist-manifest.mjs",
    "verify:package-lock-receipt": "npm run check:package-lock-receipt",
    "verify:release-artifacts": "npm run check:release-artifacts",
    "verify:runtime-environment-receipt": "npm run check:runtime-environment-receipt",
    "verify:web-dist-receipt": "npm run check:web-dist-receipt",
    "write:management-openapi": "node scripts/generate-management-openapi.mjs",
    "write:management-openapi-compatibility": "node scripts/check-management-openapi-compatibility.mjs --fixture-path docs/artifacts/management-openapi-compatibility-0.1.0.json",
    "write:package-lock-receipt": "node scripts/check-package-lock.mjs --receipt-path docs/artifacts/package-lock-audit-0.1.0.json",
    "write:release-artifacts": "node scripts/check-release-artifacts.mjs --receipt-path docs/artifacts/release-artifacts-audit-0.1.0.json",
    "write:runtime-environment-receipt": "node scripts/check-runtime-environment.mjs --receipt-path docs/artifacts/runtime-environment-audit-0.1.0.json",
    "write:web-dist-receipt": "node scripts/check-web-dist.mjs --receipt-path docs/artifacts/web-dist-audit-0.1.0.json"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "concurrently": "9.2.4",
    "prettier": "3.8.4",
    "typescript": "5.9.3",
    "vitest": "4.1.9"
  }
}
