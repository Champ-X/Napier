    "test:live-browser": "npm run test:live-browser -w @napier/runtime",
    "test:live-coder": "npm run test:live-coder -w @napier/runtime",
    "test:live-command": "npm run test:live-command -w @napier/runtime",
    "test:live-coding-benchmark": "npm run test:live-coding-benchmark -w @napier/benchmark-kit",
    "test:live-cli": "npm run test:live-deepseek -w @napier/cli",
    "test:live-files": "npm run test:live-files -w @napier/runtime",
    "test:live-lsp": "npm run test:live-lsp -w @napier/runtime",
    "test:live-linked-tests": "npm run test:live-linked-tests -w @napier/runtime",
    "test:live-map": "npm run test:live-map -w @napier/runtime",
    "test:live-loop": "npm run test:live-loop -w @napier/runtime",
    "test:live-process": "npm run test:live-process -w @napier/runtime",
    "test:live-provider": "npm run test:live-provider -w @napier/runtime",
    "test:live-research-benchmark": "npm run test:live-research-benchmark -w @napier/benchmark-kit",
    "test:live-open-web-security-benchmark": "npm run test:live-open-web-security-benchmark -w @napier/benchmark-kit",
    "test:live-ux-benchmark": "npm run test:live-ux-benchmark -w @napier/benchmark-kit",
    "test:live-sqlite": "npm run test:live-sqlite -w @napier/runtime",
    "test:live-workflow-javascript": "npm run test:live-workflow-javascript -w @napier/runtime",
    "test:live-workflow-benchmark": "npm run test:live-workflow-benchmark -w @napier/benchmark-kit",
    "test:live-workflow-python": "npm run test:live-workflow-python -w @napier/runtime",
    "test:live-workflow-step": "npm run test:live-workflow-step -w @napier/cli",
    "test:web-ui-e2e": "npm run build:core && npm run build -w @napier/server && npm run build -w @napier/web && npm run check:web-ui-e2e",
    "test:live-deepseek": "npm run test:live-deepseek -w @napier/runtime",
    "test:root": "vitest run scripts/*.test.mjs --testTimeout=30000",
    "typecheck": "npm run build:core && npm run typecheck -w @napier/sdk && npm run typecheck -w @napier/cli && npm run typecheck -w @napier/benchmark-kit && npm run typecheck -w @napier/harness-eval && npm run typecheck -w @napier/server && npm run typecheck -w @napier/web",
    "update:web-dist-manifest": "node scripts/update-web-dist-manifest.mjs",
    "verify:package-lock-receipt": "npm run check:package-lock-receipt",
    "verify:release-artifacts": "npm run check:release-artifacts",
    "verify:runtime-environment-receipt": "npm run check:runtime-environment-receipt",
    "verify:web-dist-receipt": "npm run check:web-dist-receipt",
    "write:management-openapi": "node scripts/generate-management-openapi.mjs",
    "write:long-run-scale": "npm run build:core && node --expose-gc --import tsx scripts/benchmark-trace-scale.mjs --output docs/artifacts/trace-scale-baseline-0.1.0.json && node --expose-gc scripts/benchmark-store-scale.mjs --output docs/artifacts/store-scale-baseline-0.2.0.json",
    "write:default-product-consolidated": "npm run build:core && node scripts/consolidate-default-product-gates.mjs --output docs/artifacts/default-product-consolidated-m4-0.1.2.json",
    "write:default-product-source": "node scripts/release-product-source-manifest.mjs --write",
    "write:linux-host-product-acceptance": "node scripts/check-linux-host-product-acceptance.mjs --write",
    "write:architecture-baseline": "node scripts/check-architecture.mjs --write-baseline",
    "write:management-openapi-compatibility": "node scripts/check-management-openapi-compatibility.mjs --fixture-path docs/artifacts/management-openapi-compatibility-0.1.0.json",
    "write:oci-resource-limits": "node scripts/check-oci-resource-limits.mjs --write",
    "write:oci-crash-recovery": "node scripts/check-oci-crash-recovery.mjs --write",
    "write:package-lock-receipt": "node scripts/check-package-lock.mjs --receipt-path docs/artifacts/package-lock-audit-0.1.0.json",
    "write:profile-upgrade": "node scripts/check-profile-upgrade.mjs --write",
    "write:s1-shell-sandbox-readiness": "node scripts/check-s1-shell-sandbox-completion.mjs --write-readiness",
    "dispatch:sandbox-external-release": "node scripts/check-sandbox-external-release-dispatch.mjs",
    "dispatch:windows-host-product-acceptance": "node scripts/check-windows-host-product-acceptance-dispatch.mjs",
    "intake:sandbox-external-release": "node scripts/check-sandbox-external-release-intake.mjs",
    "promote:sandbox-external-release": "node scripts/check-sandbox-external-release-promotion.mjs",
    "write:release-artifacts": "npm run build:benchmark-kit && npm run build -w @napier/harness-eval && node scripts/check-release-artifacts.mjs --receipt-path docs/artifacts/release-artifacts-audit-0.1.0.json",
    "write:runtime-environment-receipt": "node scripts/check-runtime-environment.mjs --receipt-path docs/artifacts/runtime-environment-audit-0.1.0.json",
    "write:sandbox-security-casebook": "node scripts/check-sandbox-security-casebook.mjs --write",
    "write:sandbox-acquisition": "node scripts/check-sandbox-acquisition.mjs --write",
    "write:sandbox-product-acceptance": "node scripts/check-sandbox-product-acceptance.mjs --write",
    "write:sandbox-multi-architecture": "node scripts/check-sandbox-multi-architecture.mjs --write",
    "write:sandbox-portable-process": "node scripts/check-sandbox-portable-process.mjs --write",
    "write:sandbox-portable-lsp": "node scripts/check-sandbox-portable-lsp.mjs --write",
    "write:sandbox-portable-dap": "node scripts/check-sandbox-portable-dap.mjs --write",
    "write:sandbox-oci-supply-chain": "node scripts/check-sandbox-oci-supply-chain.mjs --write",
    "write:sandbox-image-sbom": "node scripts/check-sandbox-image-sbom.mjs --write",
    "write:web-dist-receipt": "node scripts/check-web-dist.mjs --receipt-path docs/artifacts/web-dist-audit-0.1.0.json"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.82.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@types/node": "24.12.4",
    "concurrently": "9.2.4",
    "jscpd": "5.0.16",
    "knip": "6.32.2",
    "playwright-core": "1.62.1",
    "prettier": "3.8.4",
    "typebox": "1.1.38",
    "typescript": "5.9.3",
    "tsx": "4.22.1",
