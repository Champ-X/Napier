    "check:web-ui-e2e": "node scripts/run-web-ui-e2e.mjs",
    "check:web-dist": "node scripts/check-web-dist.mjs",
    "check:web-design": "node scripts/check-web-design.mjs",
    "check:web-dist-manifest": "node scripts/update-web-dist-manifest.mjs --check",
    "check:web-dist-receipt": "node scripts/check-web-dist.mjs --verify-receipt-path docs/artifacts/web-dist-audit-0.1.0.json",
    "dev": "npm run build:core && node --env-file-if-exists=.env node_modules/concurrently/dist/bin/concurrently.js -n contracts,runtime,server,web -c magenta,green,yellow,cyan \"npm run dev -w @napier/contracts\" \"npm run dev -w @napier/runtime\" \"npm run dev -w @napier/server\" \"npm run dev -w @napier/web\"",
