    "format": "prettier --write .",
    "napier": "npm run build:core && npm run build -w @napier/cli && node --env-file-if-exists=.env apps/cli/dist/index.js",
    "napier:dev": "node --env-file-if-exists=.env apps/cli/dist/index.js",
