    "check:release-artifacts": "npm run build:benchmark-kit && npm run build -w @napier/harness-eval && node scripts/check-release-artifacts.mjs --verify-receipt-path docs/artifacts/release-artifacts-audit-0.1.0.json",
    "check:harness-experiment-release": "npm run build:harness-eval && node scripts/create-harness-experiment-release-evidence.mjs --verify docs/artifacts/harness-experiment-release-evidence-0.1.3.json",
    "check:agent-harness-acceptance": "npm run build:harness-eval && node scripts/create-agent-harness-acceptance-evidence.mjs --verify docs/artifacts/agent-harness-acceptance-evidence-0.1.3.json",
    "check:runtime-environment": "node scripts/check-runtime-environment.mjs",
    "check:runtime-environment-receipt": "node scripts/check-runtime-environment.mjs --verify-receipt-path docs/artifacts/runtime-environment-audit-0.1.0.json",
    "check:sandbox-security-casebook": "node scripts/check-sandbox-security-casebook.mjs",
    "check:sandbox-security-casebook:live": "node scripts/check-sandbox-security-casebook.mjs --live",
    "check:sandbox-product-acceptance": "node scripts/check-sandbox-product-acceptance.mjs",
