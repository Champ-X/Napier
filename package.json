{
  "name": "napier",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "bench:coding": "npm run build:benchmark-kit && node --env-file-if-exists=.env scripts/run-coding-benchmark.mjs",
    "bench:coding:compare": "npm run build:benchmark-kit && node --env-file-if-exists=.env scripts/run-coding-executor-comparison.mjs",
    "bench:browser:confirmed-form": "npm run build:benchmark-kit && node --env-file-if-exists=.env scripts/run-browser-confirmed-form-benchmark.mjs",
    "bench:browser:compare": "npm run build:core && npm run build -w @napier/cli && node --env-file-if-exists=.env scripts/run-browser-autonomy-comparison.mjs",
    "evidence:controlled-harness": "npm run build:core && node scripts/create-controlled-harness-evidence.mjs",
    "evidence:agent-harness-acceptance": "npm run build:harness-eval && node --env-file-if-exists=.env scripts/create-agent-harness-acceptance-evidence.mjs",
    "evidence:harness-experiment-release": "npm run build:harness-eval && node scripts/create-harness-experiment-release-evidence.mjs",
    "bench:goal-no-progress": "npm run build:benchmark-kit && node --env-file-if-exists=.env scripts/run-goal-no-progress-benchmark.mjs",
