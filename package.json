    "bench:research:open-web:freshness": "npm run build:benchmark-kit && node scripts/run-open-web-research-freshness-campaign.mjs",
    "bench:security:open-web": "npm run build:benchmark-kit && node --env-file-if-exists=.env scripts/run-open-web-research-benchmark.mjs --case benchmarks/security/open-web-prompt-injection-v1 --trials 2",
    "bench:ux": "npm run build:benchmark-kit && node --env-file-if-exists=.env scripts/run-ux-benchmark.mjs",
    "bench:workflow": "npm run build:benchmark-kit && node --env-file-if-exists=.env scripts/run-workflow-benchmark.mjs",
