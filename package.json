    "check:default-product-source": "node scripts/release-product-source-manifest.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:compatibility-ledger": "node scripts/check-compatibility-ledger.mjs",
    "check:dead-code": "node scripts/check-dead-code.mjs",
    "check:duplicates": "node scripts/check-duplicates.mjs",
    "check:dependency-ownership": "node scripts/check-dependency-ownership.mjs",
    "check:desktop-scope": "node scripts/check-desktop-scope.mjs",
    "check:public-api": "node scripts/check-public-api.mjs",
    "check:management-openapi": "node scripts/generate-management-openapi.mjs --check",
    "check:management-openapi-compatibility": "node scripts/check-management-openapi-compatibility.mjs --verify-fixture-path docs/artifacts/management-openapi-compatibility-0.1.0.json",
    "check:linux-host-product-acceptance": "node scripts/check-linux-host-product-acceptance.mjs",
    "check:linux-host-product-acceptance:live": "node scripts/check-linux-host-product-acceptance.mjs --live",
    "check:windows-host-product-acceptance": "node scripts/check-windows-host-product-acceptance.mjs",
    "check:windows-host-product-acceptance-workflow": "node scripts/check-windows-host-product-acceptance-workflow.mjs",
    "check:oci-resource-limits": "node scripts/check-oci-resource-limits.mjs",
    "check:package-lock": "node scripts/check-package-lock.mjs",
    "check:package-lock-receipt": "node scripts/check-package-lock.mjs --verify-receipt-path docs/artifacts/package-lock-audit-0.1.0.json",
